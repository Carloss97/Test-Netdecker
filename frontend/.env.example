# Local frontend environment example
# Copy to frontend/.env: cp frontend/.env.example frontend/.env

VITE_API_URL=http://localhost:3334/api
VITE_API_FORCE_SAME_ORIGIN=0
VITE_APP_NAME=TCG Singles Platform
VITE_APP_VERSION=0.1.0

# TCGCSV is the only allowed remote catalog/price source in local MVP mode.
VITE_TCGCSV_BASE=https://tcgcsv.com/tcgplayer
VITE_ALLOW_TCGCSV_DIRECT=false

# Manual/local pricing fallback; mirrors backend MANUAL_USD_TO_CLP.
VITE_MANUAL_USD_TO_CLP=1000
