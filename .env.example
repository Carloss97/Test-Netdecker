# Backend Environment Variables
# Copy to backend/.env

PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/tcg_singles_db"

# Redis
REDIS_URL="redis://localhost:6379"

# External APIs — TCGPlayer (optional, for price sync)
TCGPLAYER_API_KEY=""
TCGPLAYER_API_SECRET=""

# External Card Database APIs
# Pokémon TCG API key (optional — increases rate limit from 1000/day to unlimited)
POKEMON_TCG_API_KEY=""

# Exchange rate
EXCHANGE_RATE_API_URL="https://api.exchangerate-api.com/v4/latest"
EXCHANGE_RATE_API_KEY=""

# Price sync
PRICE_SYNC_ENABLED="true"
PRICE_SYNC_CRON="0 */6 * * *"
PRICE_ROUNDING_MULTIPLE="1"

# File Upload
MAX_UPLOAD_SIZE="10mb"
UPLOAD_DIR="./uploads"

# Admin (initial setup only)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# Frontend Environment Variables
# Copy to frontend/.env.local

VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=TCG Singles Platform
