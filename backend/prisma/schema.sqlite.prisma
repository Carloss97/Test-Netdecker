// SQLite variant of the Prisma schema for local development without Postgres.
// Generator outputs the client to `node_modules/@prisma/client_sqlite` inside the backend package.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client_sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: Enums are converted to `String` fields for SQLite (no native enum support).

// ============================================
// CORE ENTITIES
// ============================================

// Multi-tenant store
model Store {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  apiKeyHash  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  listings    Listing[]
  warehouses  Warehouse[]
  imports     InventoryImport[]
  carts       Cart[]
  orders      Order[]
  priceSyncs  PriceSyncRun[]
  accounts    Account[]
  journalEntries JournalEntry[]
}


model TCG {
  id             String    @id @default(cuid())
  name           String   @unique
  displayName    String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  editions       Edition[]
  cards          Card[]
}

model Edition {
  id             String    @id @default(cuid())
  tcgId          String
  tcg            TCG       @relation(fields: [tcgId], references: [id], onDelete: Cascade)
  editionCode    String
  editionName    String
  releaseDate    DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@unique([tcgId, editionCode])
  cards          Card[]
  listings       Listing[]
  priceVolatilityThresholds PriceVolatilityThreshold[]
}

model Card {
  id             String    @id @default(cuid())
  tcgId          String
  tcg            TCG       @relation(fields: [tcgId], references: [id], onDelete: Cascade)
  editionId      String
  edition        Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  cardCode       String
  cardName       String
  cardNumber     String?
  rarity         String
  colorIdentity  String?
  tags           String    @default("")
  imageUrl       String?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@unique([tcgId, editionId, cardCode, rarity])
  @@index([tcgId])
  @@index([editionId])
  @@index([cardCode])
  listings       Listing[]
}

model Listing {
  id             String    @id @default(cuid())
  cardId         String
  card           Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  editionId      String
  edition        Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  condition      String  @default("NM")
  rarity         String
  quantity       Int       @default(0)
  referencePrice Float
  marginMultiplier Float  @default(1.2)
  exchangeRate   Float    @default(1.0)
  finalPrice     Float
  currency       String   @default("CLP")
  costPrice      Float?
  status         String   @default("active")
  lastSyncedAt   DateTime?
  everHadStock   Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Optional tenant scoping
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@unique([cardId, condition, rarity])
  @@index([cardId])
  @@index([quantity])
  @@index([storeId])
    priceHistory   PriceHistory[]
    orderItems     OrderItem[]
    stockMovements StockMovement[]
    stockSnapshots StockSnapshot[]
    warehouseStocks WarehouseStock[]
    reservations    Reservation[]
    inventoryImportChanges InventoryImportChange[]
    priceChangeApprovals PriceChangeApproval[]
}

model PriceHistory {
  id             String    @id @default(cuid())
  listingId      String
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  oldPrice       Float
  newPrice       Float
  oldReferencePrice Float?
  newReferencePrice Float?
  oldExchangeRate Float?
  newExchangeRate Float?
  reason         String
  percentChange  Float
  changedBy      String?
  notes          String?
  createdAt      DateTime  @default(now())
  @@index([listingId])
  @@index([createdAt])
}

model InventoryImport {
  id             String    @id @default(cuid())
  fileName       String
  fileHash       String    @unique
  totalRecords   Int
  successCount   Int       @default(0)
  failureCount   Int       @default(0)
  status         String    @default("processing")
  errors         String?
  importedBy     String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([storeId])
  changes        InventoryImportChange[]
}

model Cart {
  id             String    @id @default(cuid())
  sessionId      String
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([sessionId])
  @@index([storeId])
}

model OrderItem {
  id             String    @id @default(cuid())
  cartId         String?
  cart           Cart?     @relation(fields: [cartId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  quantity       Int
  pricePerUnit   Float
  subtotal       Float
  createdAt      DateTime  @default(now())
}

model Order {
  id             String    @id @default(cuid())
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber    String    @unique
  customerEmail  String
  status         String  @default("PENDING")
  items          OrderItem[]
  subtotal       Float
  tax            Float     @default(0.0)
  total          Float
  shippingAddress String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  @@index([customerEmail])
  @@index([status])
  @@index([storeId])
}

model ExchangeRate {
  id             String    @id @default(cuid())
  fromCurrency   String   @default("USD")
  toCurrency     String   @default("CLP")
  rate           Float
  source         String
  fetchedAt      DateTime  @default(now())
  expiresAt      DateTime?
  @@unique([fromCurrency, toCurrency])
}

model PriceSyncRun {
  id               String   @id @default(cuid())
  source           String
  status           String   @default("running")
  notes            String?
  total            Int      @default(0)
  updated          Int      @default(0)
  volatile         Int      @default(0)
  failed           Int      @default(0)
  roundingMultiple Int      @default(1)
  errors           String?
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  
  storeId          String?
  store            Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([startedAt])
  @@index([source])
  @@index([status])
}

// ============================================
// ERP: INVENTORY & ACCOUNTING MODELS (SQLite)
// Note: enums are represented as Strings in this SQLite schema.
// ============================================

model Warehouse {
  id          String   @id @default(cuid())
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  metadata    String?

  // Relations
  stockMovements     StockMovement[] @relation("StockMovement_warehouse")
  stockMovementsFrom StockMovement[] @relation("StockMovement_from")
  stockMovementsTo   StockMovement[] @relation("StockMovement_to")
  stockSnapshots     StockSnapshot[]
  warehouseStocks    WarehouseStock[]
  reservations       Reservation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([storeId])
}

model StockMovement {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  warehouseId     String?
  warehouse       Warehouse? @relation("StockMovement_warehouse", fields: [warehouseId], references: [id], onDelete: SetNull)

  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("StockMovement_from", fields: [fromWarehouseId], references: [id], onDelete: SetNull)

  toWarehouseId   String?
  toWarehouse     Warehouse? @relation("StockMovement_to", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  quantity        Int
  type            String
  reference       String?
  performedBy     String?
  notes           String?

  createdAt       DateTime @default(now())

  @@index([listingId])
  @@index([warehouseId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockSnapshot {
  id           String    @id @default(cuid())
  listingId    String
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  quantity     Int
  takenAt      DateTime  @default(now())

  @@index([listingId])
  @@index([warehouseId])
  @@index([takenAt])
}

model WarehouseStock {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  quantity    Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([listingId, warehouseId])
  @@index([warehouseId])
  @@index([listingId])
}

model Reservation {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  quantity     Int
  reservedBy   String?
  status       String   @default("ACTIVE")
  expiresAt    DateTime?

  createdAt    DateTime @default(now())

  @@index([listingId])
  @@index([warehouseId])
  @@index([status])
}

model Account {
  id        String    @id @default(cuid())
  storeId   String?
  store     Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  code      String
  name      String
  type      String
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())

  journalLines JournalLine[]

  @@unique([storeId, code])
  @@index([storeId])
}

model JournalEntry {
  id          String    @id @default(cuid())
  storeId     String?
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  entryNumber Int?
  description String?
  date        DateTime  @default(now())
  totalDebit  Float
  totalCredit Float
  createdAt   DateTime  @default(now())

  lines       JournalLine[]

  @@index([storeId])
  @@index([date])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?
  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([accountId])
}

// Tracks atomic changes made during an inventory import, allowing rollback
// of per-listing quantity changes.
model InventoryImportChange {
  id            String   @id @default(cuid())
  importId      String
  import        InventoryImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  oldQuantity   Int
  newQuantity   Int
  note          String?
  createdAt     DateTime @default(now())

  @@index([importId])
  @@index([listingId])
}

// Approval requests for price changes marked volatile by automated sync.
model PriceChangeApproval {
  id            String   @id @default(cuid())

  listingId     String?
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  oldFinalPrice Float?
  newFinalPrice Float
  newReferencePrice Float
  marginMultiplier Float
  percentChange Float

  status        String   @default("PENDING")
  requestedBy   String?
  processedBy   String?
  processedAt   DateTime?
  notes         String?

  createdAt     DateTime @default(now())

  @@index([listingId])
  @@index([status])
}

// Configurable volatility thresholds per TCG or per Edition (SQLite variant uses strings for enums).
model PriceVolatilityThreshold {
  id               String   @id @default(cuid())
  tcg              String?
  editionId        String?
  edition          Edition? @relation(fields: [editionId], references: [id], onDelete: Cascade)
  thresholdPercent Float    @default(10.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@index([tcg])
  @@index([editionId])
}

// Admin authentication + audit models (SQLite uses strings for enums)
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  passwordSalt String
  role         String   @default("ADMIN")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  sessions     AdminSession[]
  auditTrails  AuditTrail[]
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditTrail {
  id         String   @id @default(cuid())
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String?
  entityId   String?
  ip         String?
  userAgent  String?
  data       String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
}
