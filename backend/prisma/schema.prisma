// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum TCGType {
  MAGIC
  POKEMON
  YUGIOH
  ONE_PIECE
  DIGIMON
  WEISS_SCHWARZ
}

enum CardCondition {
  NM   // Near Mint
  LP   // Lightly Played
  MP   // Moderately Played
  HP   // Heavily Played
  DMG  // Damaged
}

enum PriceUpdateReason {
  TCGPLAYER_SYNC
  EXTERNAL_API_SYNC
  MANUAL_UPDATE
  DEMAND_ADJUSTMENT
  VOLATILE_ALERT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// Accounting / ERP enums
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  COMMITTED
  EXPIRED
}

// ============================================
// CORE ENTITIES
// ============================================

// Multi-tenant store
model Store {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. "mi-tienda"
  name        String
  description String?
  apiKeyHash  String?  // hashed API key for store-scoped API keys

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  listings    Listing[]
  warehouses  Warehouse[]
  imports     InventoryImport[]
  carts       Cart[]
  orders      Order[]
  priceSyncs  PriceSyncRun[]
  accounts    Account[]
  journalEntries JournalEntry[]
}


model TCG {
  id             String    @id @default(cuid())
  name           TCGType   @unique
  displayName    String    // "Magic: The Gathering", "Pokémon", etc.
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  editions       Edition[]
  cards          Card[]
}

model Edition {
  id             String    @id @default(cuid())
  tcgId          String
  tcg            TCG       @relation(fields: [tcgId], references: [id], onDelete: Cascade)
  
  editionCode    String    // "M25", "SV05", "2024", etc.
  editionName    String    // "Magic 2025", "Scarlet & Violet", etc.
  releaseDate    DateTime?
  isActive       Boolean   @default(true)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Unique constraint: only one edition per TCG per code
  @@unique([tcgId, editionCode])
  
  // Relations
  cards          Card[]
  listings       Listing[]
}

model Card {
  id             String    @id @default(cuid())
  tcgId          String
  tcg            TCG       @relation(fields: [tcgId], references: [id], onDelete: Cascade)
  
  editionId      String
  edition        Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  // Card identifiers and metadata
  cardCode       String    // External API ID (Scryfall UUID, Pokemon ID, YGO ID, OPTCG ID)
  cardName       String
  cardNumber     String?   // Collector number
  rarity         String    // "Rare", "Common", etc.
  colorIdentity String?   // For Magic: "WUB", for others: relevant color system
  
  // For search and filtering
  tags           String    @default("")  // JSON or comma-separated tags
  imageUrl       String?
  description    String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Unique: TCG + Edition + Card Code + Rarity
  @@unique([tcgId, editionId, cardCode, rarity])
  @@index([tcgId])
  @@index([editionId])
  @@index([cardCode])
  
  // Relations
  listings       Listing[]
}

// ============================================
// INVENTORY & PRICING
// ============================================

model Listing {
  id             String    @id @default(cuid())
  
  // Optional store scoping for multitenancy. Nullable for backwards compatibility.
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  cardId         String
  card           Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  editionId      String
  edition        Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  // Condition, rareza y cantidad
  condition      CardCondition  @default(NM)
  rarity         String         // Rareza específica de este listing
  quantity       Int       @default(0)

  // Pricing
  referencePrice Float    // Price in USD from external APIs (Scryfall, Pokemon TCG, YGOPRODeck, OPTCGAPI)
  marginMultiplier Float  @default(1.2)  // 1.2 = 20% markup
  exchangeRate   Float    @default(1.0)  // USD to CLP rate at time of calculation

  finalPrice     Float    // Computed: referencePrice * marginMultiplier * exchangeRate
  currency       String   @default("CLP")

  // Cost tracking
  costPrice      Float?   // What was paid for it

  // Status
  status         String   @default("active")  // "active", "discontinued", "reserved"
  lastSyncedAt   DateTime?

  // Tracks whether this listing ever had quantity > 0 (set to true on first stock-in)
  everHadStock   Boolean  @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([cardId, condition, rarity])
  @@index([cardId])
  @@index([quantity])
  @@index([storeId])

  // Relations
  priceHistory   PriceHistory[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  stockSnapshots StockSnapshot[]
  warehouseStocks WarehouseStock[]
  reservations    Reservation[]
}

model PriceHistory {
  id             String    @id @default(cuid())
  
  listingId      String
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  // Change tracking
  oldPrice       Float
  newPrice       Float
  oldReferencePrice Float?
  newReferencePrice Float?
  oldExchangeRate Float?
  newExchangeRate Float?
  
  reason         PriceUpdateReason
  percentChange  Float    // (newPrice - oldPrice) / oldPrice * 100
  
  changedBy      String?  // User ID or "system"
  notes          String?
  
  createdAt      DateTime  @default(now())
  
  @@index([listingId])
  @@index([createdAt])
}

// ============================================
// INVENTORY IMPORT
// ============================================

model InventoryImport {
  id             String    @id @default(cuid())
  
  fileName       String
  fileHash       String    @unique  // To prevent duplicate imports
  
  totalRecords   Int
  successCount   Int       @default(0)
  failureCount   Int       @default(0)
  
  status         String    @default("processing")  // "processing", "completed", "failed"
  errors         String?   // JSON array of errors
  
  importedBy     String?   // User ID
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  
  // Which store performed this import (nullable for existing records)
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([storeId])
}

// ============================================
// ERP: INVENTORY MODELS (MVP)
// ============================================

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUST
}

model Warehouse {
  id          String   @id @default(cuid())
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  metadata    Json?
  
  // Relations
  stockMovements     StockMovement[] @relation("StockMovement_warehouse")
  stockMovementsFrom StockMovement[] @relation("StockMovement_from")
  stockMovementsTo   StockMovement[] @relation("StockMovement_to")
  stockSnapshots     StockSnapshot[]
  warehouseStocks     WarehouseStock[]
  reservations        Reservation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
}

model StockMovement {
  id              String            @id @default(cuid())
  listingId       String
  listing         Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // For IN/OUT movements use `warehouseId`. For TRANSFER use `fromWarehouseId` and `toWarehouseId`.
  warehouseId     String?
  warehouse       Warehouse?        @relation("StockMovement_warehouse", fields: [warehouseId], references: [id], onDelete: SetNull)

  fromWarehouseId String?
  fromWarehouse   Warehouse?        @relation("StockMovement_from", fields: [fromWarehouseId], references: [id], onDelete: SetNull)

  toWarehouseId   String?
  toWarehouse     Warehouse?        @relation("StockMovement_to", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  quantity        Int
  type            StockMovementType
  reference       String?
  performedBy     String?
  notes           String?

  createdAt       DateTime @default(now())

  @@index([listingId])
  @@index([warehouseId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockSnapshot {
  id           String    @id @default(cuid())
  listingId    String
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  quantity     Int
  takenAt      DateTime  @default(now())

  @@index([listingId])
  @@index([warehouseId])
  @@index([takenAt])
}

// Per-warehouse on-hand quantities
model WarehouseStock {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  quantity    Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([listingId, warehouseId])
  @@index([warehouseId])
  @@index([listingId])
}

// Reservations for listings (holds) — e.g., order pending payment or temporary hold
model Reservation {
  id           String             @id @default(cuid())
  listingId    String
  listing      Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)

  warehouseId  String?
  warehouse    Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  quantity     Int
  reservedBy   String?            // orderId, cart session, or user id
  status       ReservationStatus  @default(ACTIVE)
  expiresAt    DateTime?

  createdAt    DateTime           @default(now())

  @@index([listingId])
  @@index([warehouseId])
  @@index([status])
}

// Accounting models: basic double-entry bookkeeping primitives
model Account {
  id        String    @id @default(cuid())
  storeId   String?
  store     Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  code      String
  name      String
  type      AccountType
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  journalLines JournalLine[]

  @@unique([storeId, code])
  @@index([storeId])
}

model JournalEntry {
  id          String    @id @default(cuid())
  storeId     String?
  store       Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  entryNumber Int?
  description String?
  date        DateTime  @default(now())
  totalDebit  Float
  totalCredit Float
  createdAt   DateTime  @default(now())

  lines       JournalLine[]

  @@index([storeId])
  @@index([date])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?
  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([accountId])
}

// ============================================
// ORDERS & CHECKOUT
// ============================================

model Cart {
  id             String    @id @default(cuid())
  
  // Which store this cart belongs to (nullable for existing sessions)
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  sessionId      String    // Session or user ID
  
  items          OrderItem[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([sessionId])
  @@index([storeId])
}

model OrderItem {
  id             String    @id @default(cuid())
  
  cartId         String?
  cart           Cart?     @relation(fields: [cartId], references: [id], onDelete: SetNull)
  
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  listingId      String
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  
  quantity       Int
  pricePerUnit   Float    // Snapshot of price at time of add-to-cart
  subtotal       Float    // quantity * pricePerUnit
  
  createdAt      DateTime  @default(now())
}

model Order {
  id             String    @id @default(cuid())
  
  // Tenant scoping
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  orderNumber    String    @unique
  customerEmail  String
  status         OrderStatus  @default(PENDING)
  
  items          OrderItem[]
  
  subtotal       Float
  tax            Float     @default(0.0)
  total          Float
  
  shippingAddress String?
  notes          String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([customerEmail])
  @@index([status])
  @@index([storeId])
}

// ============================================
// EXCHANGE RATES (CACHE)
// ============================================

model ExchangeRate {
  id             String    @id @default(cuid())
  
  fromCurrency   String   @default("USD")
  toCurrency     String   @default("CLP")
  rate           Float
  
  source         String   // "api.example.com", "manual", etc.
  fetchedAt      DateTime  @default(now())
  expiresAt      DateTime?
  
  @@unique([fromCurrency, toCurrency])
}

model PriceSyncRun {
  id               String   @id @default(cuid())
  
  // Optional per-store runs
  storeId          String?
  store            Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  source           String   // "manual" | "cron"
  status           String   @default("running") // "running" | "completed" | "failed"
  notes            String?

  total            Int      @default(0)
  updated          Int      @default(0)
  volatile         Int      @default(0)
  failed           Int      @default(0)
  roundingMultiple Int      @default(1)

  errors           String?  // JSON array of run errors
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([startedAt])
  @@index([source])
  @@index([status])
}
