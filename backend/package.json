{
  "name": "tcg-singles-backend",
  "version": "0.1.0",
  "description": "Backend API for TCG Singles platform with dynamic pricing",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:sqlite": "USE_SQLITE=true DATABASE_URL=\"file:./dev.sqlite\" tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:sqlite": "USE_SQLITE=true DATABASE_URL=\"file:./dev.sqlite\" node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "backfill:tcgplayer": "tsx src/scripts/backfillTcgplayerProductId.ts",
    "backfill:tcgplayer:dry": "tsx src/scripts/backfillTcgplayerProductId.ts --dry-run",
    "catalog:bootstrap": "tsx src/scripts/bootstrapCatalog.ts",
    "prisma:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "test:sqlite": "USE_SQLITE=true DATABASE_URL=\"file:./dev.sqlite\" tsx --test src/**/*.test.ts",
    "backfill:warehouse-stock": "tsx scripts/backfill-warehouse-stock.ts",
    "catalog:bootstrap:dry": "tsx src/scripts/bootstrapCatalog.ts --dry-run",
    "catalog:sync": "tsx src/scripts/catalogSync.ts",
    "catalog:sync:dry": "tsx src/scripts/catalogSync.ts --dry-run",
    "catalog:reset:dry": "tsx src/scripts/resetCatalog.ts",
    "catalog:reset": "tsx src/scripts/resetCatalog.ts --confirm",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test:fast": "FAST_TEST=true tsx --test src/**/*.test.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "tcg",
    "singles",
    "cards",
    "pricing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "redis": "^4.6.14",
    "stripe": "^22.0.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
    ,"prom-client": "^14.0.0",
    "@sentry/node": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "@types/xlsx": "^0.0.35",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "prisma": "^5.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
