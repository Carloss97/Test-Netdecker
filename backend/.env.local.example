# Local backend environment example for development
# Copy to backend/.env: cp backend/.env.local.example backend/.env

PORT=3334
NODE_ENV=development

# Local-only MVP mode: no external APIs except TCGCSV catalog/price data.
LOCAL_ONLY_MODE="true"
TCGCSV_ONLY_MODE="true"
TCGCSV_BASE="https://tcgcsv.com/tcgplayer"
TCGCSV_USER_AGENT="Mozilla/5.0 (compatible; NetDeckER-Local/1.0)"

# SQLite local development
USE_SQLITE="true"
DATABASE_URL="file:./dev.sqlite"

# Manual/local pricing. Used instead of any exchange-rate API.
MANUAL_USD_TO_CLP="1000"
FALLBACK_USD_TO_CLP="1000"
PRICE_ROUNDING_MULTIPLE="100"

# Redis optional. Leave empty for local development without Redis.
REDIS_URL=""

# Local admin bootstrap
ADMIN_EMAIL="admin@example.local"
ADMIN_PASSWORD="changeme123"

# Import behavior defaults. Keep false in local mode to avoid background sync surprises.
IMPORT_SET_SYNC_PRICES_DEFAULT="false"

# External payment/webhook jobs are disabled by default in local TCGCSV-only mode.
PAYMENT_RECONCILIATION_ENABLED="false"
WEBHOOK_QUEUE_ENABLED="false"

# Frontend integration (used by Vite during dev)
VITE_API_URL=http://localhost:3334/api
VITE_APP_NAME=TCG Singles Platform
VITE_MANUAL_USD_TO_CLP="1000"
