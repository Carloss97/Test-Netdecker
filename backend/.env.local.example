# Local backend environment example for development
# Copy to backend/.env: cp backend/.env.local.example backend/.env

PORT=3334
NODE_ENV=development

# Default to SQLite for local development (Cloudflare Pages D1 friendly)
USE_SQLITE="true"
DATABASE_URL="file:./dev.sqlite"

# Optional: example Neon Postgres configuration (DO NOT commit real credentials)
# To use Neon locally, copy this file to `backend/.env` and set the values below:
# USE_SQLITE="false"
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require"

# Redis
REDIS_URL="redis://localhost:6379"

# External APIs — TCGPlayer (optional, for price sync)
TCGPLAYER_API_KEY=""
TCGPLAYER_API_SECRET=""

# Pokémon TCG API key (optional)
POKEMON_TCG_API_KEY=""

EXCHANGE_RATE_API_URL="https://api.exchangerate-api.com/v4/latest"
EXCHANGE_RATE_API_KEY=""

PRICE_SYNC_ENABLED="true"
PRICE_SYNC_CRON="0 */6 * * *"
PRICE_ROUNDING_MULTIPLE="1"

MAX_UPLOAD_SIZE="10mb"
UPLOAD_DIR="./uploads"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# Import behavior defaults
IMPORT_SET_SYNC_PRICES_DEFAULT="true"

# Frontend integration (used by Vite during dev)
VITE_API_URL=http://localhost:3334/api
VITE_APP_NAME=TCG Singles Platform
