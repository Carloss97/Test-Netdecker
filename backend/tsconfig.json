{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "noImplicitAny": false,
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "types": ["node"]
  },
    "rootDir": "./src",
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "../functions/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
