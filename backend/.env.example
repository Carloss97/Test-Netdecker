# Backend Environment Variables
# Default to Postgres for development. Set `USE_SQLITE=true` to opt into SQLite.
USE_SQLITE="false"
DATABASE_URL="postgresql://user:password@localhost:5432/tcg_singles_db"
REDIS_URL="redis://localhost:6379"

# Optional: Use SQLite for local development instead of Postgres.
# To enable SQLite locally set `USE_SQLITE=true` and use a file-based DATABASE_URL:
# USE_SQLITE="true"
# DATABASE_URL="file:./dev.sqlite"

# Server
PORT=3333
NODE_ENV=development

# TCGplayer Integration (optional key for API access)
TCGPLAYER_API_KEY=""
TCGPLAYER_API_SECRET=""

# Exchange Rate API
EXCHANGE_RATE_API_URL="https://api.exchangerate-api.com/v4/latest"
EXCHANGE_RATE_API_KEY=""

# Pricing behavior
PRICE_ROUNDING_MULTIPLE="1"
PRICE_SYNC_ENABLED="true"
PRICE_SYNC_CRON="0 */6 * * *"
# Development-only safe mode for cron sync:
# true (default in development): faster runs, avoids external API fetches
# false: use full cron sync behavior even in development
PRICE_SYNC_DEV_SAFE_MODE="true"

# Catalog sync (new sets automation)
CATALOG_SYNC_ENABLED="true"
CATALOG_SYNC_CRON="0 3 * * *"

# Admin credentials (for initial setup only)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# External Card APIs Configuration
# YGOPRODeck (Yu-Gi-Oh) - Public API, no auth required
YGOPRODECK_RATE_LIMIT_MS="50"
YGOPRODECK_CACHE_TTL="21600"

# OPTCGAPI (One Piece TCG) - Public API, no auth required
OPTCGAPI_RATE_LIMIT_MS="500"
OPTCGAPI_CACHE_TTL="86400"
OPTCGAPI_ENDPOINT="https://www.optcgapi.com/api"

# Pokémon TCG API (optional)
POKEMON_TCG_API_KEY=""

# File Upload
MAX_UPLOAD_SIZE="10mb"
UPLOAD_DIR="./uploads"
