# Example staging environment for the backend
# Copy this to `/home/<user>/staging.env` on the staging server and populate secrets.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tcg_singles_db"
REDIS_URL="redis://localhost:6379"

# Server
PORT=3333
NODE_ENV=production

# Optional API keys
TCGPLAYER_API_KEY=""
EXCHANGE_RATE_API_URL="https://api.exchangerate-api.com/v4/latest"
EXCHANGE_RATE_API_KEY=""

# Pricing behavior
PRICE_ROUNDING_MULTIPLE="1"
PRICE_SYNC_ENABLED="false"
PRICE_SYNC_CRON="0 */6 * * *"
CATALOG_SYNC_ENABLED="false"

# Admin credentials (use secure secrets for production)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# File upload
MAX_UPLOAD_SIZE="10mb"
UPLOAD_DIR="./uploads"
IMPORT_API_KEY=""
